# CareAI Platform - Git Ignore Rules

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Database files (local dev only)
*.db
*.sqlite3

# Environment files (contain secrets)
.env
*.env.local

# Uploads directory (files stored in S3 in production)
uploads/

# Flutter
mobile/.dart_tool/
mobile/.packages
mobile/.pub/
mobile/build/
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
mobile/android/.gradle/
mobile/android/local.properties
mobile/ios/Pods/
mobile/ios/.symlinks/
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Runner/GeneratedPluginRegistrant.*
mobile/*.iml

# React Admin
admin/node_modules/
admin/dist/
admin/build/
admin/.cache/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store

# Docker
docker-compose.override.yml

# Logs
*.log
logs/

# Node
node_modules/
npm-debug.log*

# Coverage
coverage/
.coverage
htmlcov/
