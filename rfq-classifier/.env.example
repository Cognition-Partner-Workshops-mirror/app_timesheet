# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
LLM_MODEL=gpt-4o

# Azure Document Intelligence (optional, for production OCR)
AZURE_DI_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DI_KEY=your-azure-key-here

# Classification Thresholds
RULE_HIGH_CONFIDENCE_THRESHOLD=0.90
RULE_LOW_CONFIDENCE_THRESHOLD=0.70
LLM_HIGH_CONFIDENCE_THRESHOLD=0.85
LLM_VALIDATION_CONFIDENCE_THRESHOLD=0.80
MIN_CONFIDENCE_FOR_AUTO_CLASSIFY=0.80

# OCR Provider: "pytesseract" or "azure_di"
OCR_PROVIDER=pytesseract

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
