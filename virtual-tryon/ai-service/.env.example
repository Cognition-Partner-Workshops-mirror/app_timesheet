# Virtual Try-On AI Service Configuration
# Copy to .env and update for your environment

# Service
APP_NAME=Virtual Try-On AI Service
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8001

# GPU
USE_GPU=true
GPU_DEVICE_ID=0
MIXED_PRECISION=true

# Model paths
MODEL_DIR=./models

# Object Storage (MinIO)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=virtual-tryon
