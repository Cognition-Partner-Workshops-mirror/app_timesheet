# Virtual Try-On Backend Configuration
# Copy this to .env and update values for your environment

# Application
APP_NAME=Virtual Try-On API
APP_VERSION=1.0.0
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/virtual_tryon

# Redis
REDIS_URL=redis://localhost:6379/0

# Object Storage (MinIO)
STORAGE_ENDPOINT=localhost:9000
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadmin
STORAGE_BUCKET_NAME=virtual-tryon

# AI Service
AI_SERVICE_URL=http://localhost:8001

# JWT Secret (change in production!)
JWT_SECRET_KEY=change-this-to-a-secure-random-string

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
