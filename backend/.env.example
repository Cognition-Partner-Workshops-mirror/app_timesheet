# CareAI Backend Environment Configuration
# Copy this file to .env and update with your values

# ============ Application ============
APP_NAME=CareAI
APP_VERSION=1.0.0
DEBUG=true
SECRET_KEY=your-secret-key-change-in-production

# ============ PostgreSQL Database ============
# Primary database connection (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://careai:careai_password@localhost:5432/careai_db

# Set to true to use SQLite instead of PostgreSQL (for quick local testing)
USE_SQLITE=false
SQLITE_URL=sqlite+aiosqlite:///./careai.db

# ============ JWT Authentication ============
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ============ OpenAI (for AI features) ============
# Leave empty to use fallback AI responses
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4

# ============ AWS S3 / MinIO File Storage ============
# For AWS S3: Set your AWS credentials and bucket name
# For MinIO (self-hosted): Set S3_ENDPOINT_URL to MinIO server URL
S3_BUCKET_NAME=careai-uploads
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=  # Leave empty for AWS S3, set to http://minio:9000 for MinIO

# ============ File Upload ============
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes

# ============ CORS ============
CORS_ORIGINS=*

# ============ Server ============
HOST=0.0.0.0
PORT=8000
