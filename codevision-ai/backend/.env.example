# OpenAI API Key for GPT-4 powered code analysis
OPENAI_API_KEY=your_openai_api_key_here

# Server configuration
PORT=3002
NODE_ENV=development

# Database path
DB_PATH=./data/codevision.db

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:3000

# Microservices ports (used when running `npm run start:services`)
ANIMATION_SERVICE_PORT=3003
INTERVIEW_SERVICE_PORT=3004
AI_SERVICE_PORT=3005

# Microservice URLs (for gateway proxy — override for container/k8s deployments)
ANIMATION_SERVICE_URL=http://localhost:3003
INTERVIEW_SERVICE_URL=http://localhost:3004
AI_SERVICE_URL=http://localhost:3005
